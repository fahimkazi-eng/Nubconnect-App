# ============================================================================
# NUBCONNECT — Environment Configuration (copy to .env.local and fill in)
# ============================================================================
# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Default university tenant for this deployment
NEXT_PUBLIC_DEFAULT_UNIVERSITY_SLUG=nub

# Optional: show the Google sign-in button ONLY after the provider is enabled
# in Supabase → Authentication → Providers. Leave false/unset to hide it.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server-only secret — NEVER expose in client code or commit to Git
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# ============================================================================
# Optional media storage — Cloudflare R2 (PART 14)
# ============================================================================
# R2 is opt-in. Leave these unset to keep Supabase Storage as the default.
# All four values are SERVER-ONLY. Never rename them with NEXT_PUBLIC_.
# A presigned PUT URL is generated on the server; raw credentials are never
# sent to the browser.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-r2-bucket-name
# Optional: public custom domain for public media. Without it, public objects
# can still be uploaded and read through an owner-signed URL.
# R2_PUBLIC_BASE_URL=https://media.example.com
